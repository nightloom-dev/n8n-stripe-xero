{
  "Xero": {
    "type": "oAuth2Api",
    "data": {
      "grantType": "clientCredentials",
      "accessTokenUrl": "https://identity.xero.com/connect/token",
      "clientId": "${XERO_CLIENT_ID}",
      "clientSecret": "${XERO_CLIENT_SECRET}",
      "scope": "accounting.contacts accounting.invoices accounting.payments accounting.settings.read",
      "authentication": "header",
      "allowedHttpRequestDomains": "domains",
      "allowedDomains": "api.xero.com"
    }
  },
  "Stripe": {
    "type": "stripeApi",
    "data": {"secretKey": "${STRIPE_API_KEY}"}
  },
  "Alerts bot": {
    "type": "telegramApi",
    "data": {"accessToken": "${TELEGRAM_BOT_TOKEN}", "baseUrl": "https://api.telegram.org"}
  },
  "Ops token": {
    "type": "httpHeaderAuth",
    "data": {"name": "Authorization", "value": "Bearer ${OPS_TOKEN}"}
  }
}
