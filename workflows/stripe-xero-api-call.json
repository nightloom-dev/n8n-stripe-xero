        "jsCode": "// what the caller gets: one item per request, same order, with the parsed response body\nconst sent = ['Xero GET', 'Xero PUT', 'Stripe GET'].find(name => $(name).isExecuted);\nreturn $(sent).all().map(({ json }) => ({\n  json: json.body !== null && typeof json.body === 'object' ? json.body : { text: String(json.body ?? '') },\n}));\n"
      },
