      "name": "Objects to fetch",
      "parameters": {
        "jsCode": "// Stripe renders an event in the API version the account had back then, it may lack fields the\n// handlers read. so a missed event is queued with its object fetched now, in the pinned version\nconst byId = {};\nfor (const { json: page } of $('Stripe: events').all()) for (const e of page.data) byId[e.id] = e;\nconst base = $('Window').first().json.stripe_api_base;\nreturn $input.all().map(({ json }) => {\n  const { id, type, created, livemode, data: { object } } = byId[json.id];\n  const kind = object.object === 'refund' ? 'refunds' : 'invoices';\n  return { json: { service: 'stripe', method: 'GET', url: `${base}/v1/${kind}/${object.id}`, event: { id, type, created, livemode } } };\n});\n"
      },
