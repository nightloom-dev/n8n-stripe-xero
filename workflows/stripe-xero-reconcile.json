        },
        "query": "SELECT count(*)::int AS queued,\n       format('Reconcile: %s Stripe events never arrived by webhook, queued them now. Is the webhook endpoint healthy?',\n              count(*)) || E'\\n' || string_agg(format('• %s %s', e->>'type', e #>> '{data,object,id}'), E'\\n') AS text\n  FROM enqueue_events($1::jsonb, 'reconcile') AS q(id)\n  JOIN jsonb_array_elements($1::jsonb) AS e ON e->>'id' = q.id"
      },
