    {
      "id": "e9537182-a53c-5df8-a122-8b59d427c39a",
      "name": "Events to queue",
      "parameters": {
        "jsCode": "const STRIPE_VERSION = '2026-08-26.dahlia';\nconst wrongVersion = ev => ev.payload.api_version !== STRIPE_VERSION &&\n  `PERMANENT: event is in Stripe API version ${ev.payload.api_version}; pin the webhook endpoint to ${STRIPE_VERSION}`;\n\nconst asked = $('Objects to fetch').all();\nconst events = $('Stripe: objects').all().map(({ json: object }, i) => ({\n  ...asked[i].json.event, object: 'event', api_version: STRIPE_VERSION, data: { object },\n}));\nreturn [{ json: { events } }];\n"
      },
